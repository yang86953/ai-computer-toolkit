{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "act/linux-release-spdx-2.3-subset/v1",
  "title": "ai-computer-toolkit SPDX 2.3 release subset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spdxVersion",
    "dataLicense",
    "SPDXID",
    "name",
    "documentNamespace",
    "creationInfo",
    "packages",
    "relationships"
  ],
  "properties": {
    "spdxVersion": { "const": "SPDX-2.3" },
    "dataLicense": { "const": "CC0-1.0" },
    "SPDXID": { "const": "SPDXRef-DOCUMENT" },
    "name": { "type": "string", "minLength": 1 },
    "documentNamespace": {
      "type": "string",
      "pattern": "^https://ai-computer-toolkit\\.local/spdx/"
    },
    "creationInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created", "creators"],
      "properties": {
        "created": { "const": "1970-01-01T00:00:00Z" },
        "creators": {
          "const": ["Tool: ai-computer-toolkit-linux-release"]
        }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "SPDXID",
          "name",
          "versionInfo",
          "downloadLocation",
          "filesAnalyzed",
          "licenseConcluded",
          "licenseDeclared",
          "copyrightText",
          "checksums"
        ],
        "properties": {
          "SPDXID": { "type": "string", "pattern": "^SPDXRef-" },
          "name": { "type": "string", "minLength": 1 },
          "versionInfo": {
            "type": "string",
            "minLength": 1,
            "not": { "pattern": "\\(proc-macro\\)" }
          },
          "downloadLocation": { "const": "NOASSERTION" },
          "filesAnalyzed": { "const": false },
          "licenseConcluded": { "type": "string", "minLength": 1 },
          "licenseDeclared": { "type": "string", "minLength": 1 },
          "copyrightText": { "const": "NOASSERTION" },
          "checksums": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["algorithm", "checksumValue"],
              "properties": {
                "algorithm": { "const": "SHA256" },
                "checksumValue": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          "comment": {
            "const": "Cargo license declaration was missing or invalid SPDX; original omitted."
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "spdxElementId",
          "relationshipType",
          "relatedSpdxElement"
        ],
        "properties": {
          "spdxElementId": { "type": "string", "minLength": 1 },
          "relationshipType": { "enum": ["DESCRIBES", "DEPENDS_ON"] },
          "relatedSpdxElement": { "type": "string", "pattern": "^SPDXRef-" }
        }
      }
    }
  }
}
