{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-computer-toolkit.local/contracts/internal/sequence-execution-journal-v1.schema.json",
  "title": "Atomic sequence execution journal record",
  "$ref": "#/$defs/journalRecord",
  "$defs": {
    "executionId": {
      "type": "string",
      "pattern": "^s2:q:[0-9a-f]{32}$"
    },
    "stepId": {
      "type": "string",
      "pattern": "^s2:qs:[0-9a-f]{32}$"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "executionState": {
      "enum": [
        "created",
        "running",
        "awaiting-resume",
        "awaiting-confirmation",
        "completed",
        "failed",
        "cancelled",
        "outcome-unknown"
      ]
    },
    "stepState": {
      "enum": [
        "pending",
        "prepared",
        "dispatching",
        "completed",
        "failed",
        "outcome-unknown"
      ]
    },
    "stepError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "message": { "type": "string", "minLength": 1, "maxLength": 512 },
        "details": { "type": "object" }
      }
    },
    "stepReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stepId",
        "stepIndex",
        "stepRevision",
        "semanticDigest",
        "policyRevision",
        "state",
        "dispatchNonce",
        "acceptedMayHaveOccurred",
        "completed",
        "result",
        "error",
        "executionEvidence"
      ],
      "properties": {
        "stepId": { "$ref": "#/$defs/stepId" },
        "stepIndex": { "type": "integer", "minimum": 1, "maximum": 64 },
        "stepRevision": { "type": "integer", "minimum": 0 },
        "semanticDigest": {
          "oneOf": [
            { "$ref": "#/$defs/digest" },
            { "type": "null" }
          ]
        },
        "policyRevision": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 128
        },
        "state": { "$ref": "#/$defs/stepState" },
        "dispatchNonce": {
          "oneOf": [
            { "$ref": "#/$defs/nonce" },
            { "type": "null" }
          ]
        },
        "acceptedMayHaveOccurred": { "type": "boolean" },
        "completed": { "type": "boolean" },
        "result": { "type": ["object", "array", "string", "number", "boolean", "null"] },
        "error": {
          "oneOf": [
            { "$ref": "#/$defs/stepError" },
            { "type": "null" }
          ]
        },
        "executionEvidence": {
          "oneOf": [
            { "type": "object" },
            { "type": "null" }
          ]
        }
      }
    },
    "executionSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "executionId",
        "executionRevision",
        "state",
        "currentStep",
        "totalSteps",
        "resumable",
        "terminal",
        "outcomeUnknown",
        "cancelRequested",
        "steps",
        "workflowResult"
      ],
      "properties": {
        "contractVersion": { "const": "act/sequence-execution/v1" },
        "executionId": { "$ref": "#/$defs/executionId" },
        "executionRevision": { "type": "integer", "minimum": 0 },
        "state": { "$ref": "#/$defs/executionState" },
        "currentStep": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 64
        },
        "totalSteps": { "type": "integer", "minimum": 1, "maximum": 64 },
        "resumable": { "type": "boolean" },
        "terminal": { "type": "boolean" },
        "outcomeUnknown": { "type": "boolean" },
        "cancelRequested": { "type": "boolean" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/stepReceipt" }
        },
        "workflowResult": {
          "oneOf": [
            { "type": "object" },
            { "type": "null" }
          ]
        }
      }
    },
    "journalRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "recordRevision",
        "executionId",
        "startRequestNonce",
        "startSemanticDigest",
        "createdBrokerEpoch",
        "lastBrokerEpoch",
        "inputDigest",
        "input",
        "snapshot"
      ],
      "properties": {
        "contractVersion": { "const": "act/sequence-execution-journal/v1" },
        "recordRevision": { "type": "integer", "minimum": 0 },
        "executionId": { "$ref": "#/$defs/executionId" },
        "startRequestNonce": { "$ref": "#/$defs/nonce" },
        "startSemanticDigest": { "$ref": "#/$defs/digest" },
        "createdBrokerEpoch": { "$ref": "#/$defs/nonce" },
        "lastBrokerEpoch": { "$ref": "#/$defs/nonce" },
        "inputDigest": { "$ref": "#/$defs/digest" },
        "input": { "$ref": "../v1/sequence-input.schema.json" },
        "snapshot": { "$ref": "#/$defs/executionSnapshot" }
      }
    },
    "forgottenExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executionId", "startRequestNonce", "startSemanticDigest"],
      "properties": {
        "executionId": { "$ref": "#/$defs/executionId" },
        "startRequestNonce": { "$ref": "#/$defs/nonce" },
        "startSemanticDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "forgottenIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "recordRevision", "records"],
      "properties": {
        "contractVersion": { "const": "act/sequence-execution-forgotten/v1" },
        "recordRevision": { "type": "integer", "minimum": 0 },
        "records": {
          "type": "array",
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/forgottenExecution" }
        }
      }
    }
  }
}
