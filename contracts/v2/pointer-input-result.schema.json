{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://ui/pointer-input-result/v2",
  "title": "UIX cooperative application-internal pointer result v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok", "app", "verb", "capability", "targetId", "executionRealm",
    "requiredExecutionRealm", "executionRealmCertified", "isolationRequirement",
    "hostImpactPolicy", "data", "meta"
  ],
  "properties": {
    "ok": { "const": true },
    "app": { "const": "app" },
    "verb": { "const": "apply" },
    "capability": { "const": "ui.input.pointer@2" },
    "targetId": { "$ref": "#/$defs/windowTarget" },
    "executionRealm": { "const": "same-session-no-focus" },
    "requiredExecutionRealm": { "const": "same-session-no-focus" },
    "executionRealmCertified": { "const": true },
    "isolationRequirement": { "const": "standard" },
    "hostImpactPolicy": { "const": "background-preferred" },
    "data": { "$ref": "#/$defs/data" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["foreground", "targeting"],
      "properties": {
        "foreground": {
          "type": "object",
          "additionalProperties": false,
          "required": ["activationRequested"],
          "properties": { "activationRequested": { "const": false } }
        },
        "targeting": { "const": "opaque exact window generation" }
      }
    }
  },
  "$defs": {
    "windowTarget": {
      "type": "string",
      "pattern": "^s2:w:[0-9a-f]{16}$"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability", "targetId", "action", "coordinateSpace", "x", "y",
        "handledEvents", "outcome", "dispatchState", "accepted", "effectConfirmed",
        "finalStateReached", "effectObservation", "revision", "presentedRevision",
        "settled", "windowReResolved", "applicationPolicyEvaluated",
        "confirmationEvaluatedBeforeDiscovery", "foregroundConsentRequired",
        "hostForegroundActivationRequested", "automaticRetryProhibited", "retrySafe",
        "timeoutMs", "executionRealm", "safety"
      ],
      "properties": {
        "capability": { "const": "ui.input.pointer@2" },
        "targetId": { "$ref": "#/$defs/windowTarget" },
        "action": { "enum": ["move", "click"] },
        "coordinateSpace": { "const": "client-logical-px" },
        "x": { "type": "number", "minimum": 0, "maximum": 65535 },
        "y": { "type": "number", "minimum": 0, "maximum": 65535 },
        "handledEvents": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["pointer-move", "pointer-down", "pointer-up"] }
        },
        "outcome": { "enum": ["completed", "completed-unsettled"] },
        "dispatchState": { "const": "completed" },
        "accepted": { "const": true },
        "effectConfirmed": { "const": false },
        "finalStateReached": { "const": false },
        "effectObservation": { "const": "not-exposed-by-uix-agent-v1" },
        "revision": { "type": "integer", "minimum": 0 },
        "presentedRevision": { "type": "integer", "minimum": 0 },
        "settled": { "type": "boolean" },
        "windowReResolved": { "const": true },
        "applicationPolicyEvaluated": { "const": true },
        "confirmationEvaluatedBeforeDiscovery": { "const": true },
        "foregroundConsentRequired": { "const": false },
        "hostForegroundActivationRequested": { "const": false },
        "automaticRetryProhibited": { "const": true },
        "retrySafe": { "const": false },
        "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 30000 },
        "executionRealm": { "const": "same-session-no-focus" },
        "safety": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nativeIdentityExposed", "transportIdentityExposed", "desktopInputInjected",
            "desktopPointerMoved", "applicationInternalEventsDispatched",
            "requestScopedBalancedButtons", "x11Used", "fallback"
          ],
          "properties": {
            "nativeIdentityExposed": { "const": false },
            "transportIdentityExposed": { "const": false },
            "desktopInputInjected": { "const": false },
            "desktopPointerMoved": { "const": false },
            "applicationInternalEventsDispatched": { "const": true },
            "requestScopedBalancedButtons": { "const": true },
            "x11Used": { "const": false },
            "fallback": { "const": "none" }
          }
        }
      }
    }
  }
}
