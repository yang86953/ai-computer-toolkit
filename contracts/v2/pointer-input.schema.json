{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://ui/pointer-input/v2",
  "title": "UIX cooperative application-internal pointer input v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "coordinateSpace", "x", "y"],
  "properties": {
    "action": { "enum": ["move", "click"] },
    "coordinateSpace": { "const": "client-logical-px" },
    "x": { "type": "number", "minimum": 0, "maximum": 65535 },
    "y": { "type": "number", "minimum": 0, "maximum": 65535 },
    "timeoutMs": {
      "type": "integer",
      "minimum": 100,
      "maximum": 30000,
      "default": 30000
    }
  }
}
