{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://window/lifecycle/v2",
  "title": "UIX cooperative window lifecycle input v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["action"],
  "properties": {
    "action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "enum": ["restore", "minimize", "maximize"] } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "coordinateSpace", "width", "height"],
          "properties": {
            "type": { "const": "resize" },
            "coordinateSpace": { "const": "client-logical-px" },
            "width": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "height": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        }
      ]
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 100,
      "maximum": 30000,
      "default": 30000
    }
  }
}
