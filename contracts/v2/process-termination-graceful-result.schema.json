{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://process/termination-graceful-result/v2",
  "title": "Exact Linux process graceful termination result v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "app",
    "verb",
    "capability",
    "targetId",
    "action",
    "riskLevel",
    "mechanism",
    "outcome",
    "dispatchState",
    "accepted",
    "finalStateReached",
    "state",
    "targetReresolvedBeforeDispatch",
    "sameProcessGenerationVerified",
    "pidfdBound",
    "sameNonRootUserVerified",
    "protectedTargetCheck",
    "confirmationEvaluatedBeforeTargetAccess",
    "processOwnerGenerationBound",
    "gracefulFallbackToForce",
    "reobserveWith",
    "expectedObservation",
    "foregroundActivationRequested",
    "foregroundStateObserved",
    "desktopInputInjected",
    "retrySafe",
    "automaticRetryProhibited",
    "executionRealm",
    "requiredExecutionRealm",
    "executionRealmCertified",
    "isolationRequirement",
    "hostImpactPolicy"
  ],
  "properties": {
    "ok": { "const": true },
    "app": { "const": "process" },
    "verb": { "const": "terminate-graceful" },
    "capability": { "const": "process.terminate.graceful@2" },
    "targetId": { "type": "string", "pattern": "^s2:p:[0-9a-f]{16}$" },
    "action": { "const": "terminate-graceful" },
    "riskLevel": { "const": "high" },
    "mechanism": { "const": "process-self-termination-request" },
    "outcome": { "const": "completed" },
    "dispatchState": { "const": "completed" },
    "accepted": { "const": true },
    "finalStateReached": { "const": true },
    "state": { "const": "exited" },
    "targetReresolvedBeforeDispatch": { "const": true },
    "sameProcessGenerationVerified": { "const": true },
    "pidfdBound": { "const": true },
    "sameNonRootUserVerified": { "const": true },
    "protectedTargetCheck": { "const": true },
    "confirmationEvaluatedBeforeTargetAccess": { "const": true },
    "processOwnerGenerationBound": { "const": true },
    "gracefulFallbackToForce": { "const": false },
    "reobserveWith": { "const": "process.discover@1" },
    "expectedObservation": { "const": "target-absent" },
    "foregroundActivationRequested": { "const": false },
    "foregroundStateObserved": { "const": false },
    "desktopInputInjected": { "const": false },
    "retrySafe": { "const": false },
    "automaticRetryProhibited": { "const": true },
    "executionRealm": { "const": "host-background" },
    "requiredExecutionRealm": { "const": "host-background" },
    "executionRealmCertified": { "const": true },
    "isolationRequirement": { "const": "standard" },
    "hostImpactPolicy": { "const": "background-preferred" }
  }
}
