{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-computer-toolkit/contracts/v1/pointer-input-result.schema.json",
  "title": "Provider-neutral pointer input success result",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "app", "verb", "capability", "targetId", "data", "meta"],
  "properties": {
    "executionRealm": { "enum": ["host-headless", "host-background", "same-session-no-focus", "isolated-worker", "host-foreground", "none"] },
    "requiredExecutionRealm": { "enum": ["host-headless", "host-background", "same-session-no-focus", "isolated-worker", "host-foreground", "none"] },
    "executionRealmCertified": { "type": "boolean" },
    "isolationRequirement": { "enum": ["standard", "strict"] },
    "hostImpactPolicy": { "enum": ["background-preferred", "strict-no-interference"] },
    "interactiveSessionId": { "type": "string", "pattern": "^s2:i:[0-9a-f]{16}$" },
    "isolationKind": { "const": "independent-interactive-session" },
    "ok": { "const": true },
    "app": { "const": "app" },
    "verb": { "const": "apply" },
    "capability": { "const": "ui.input.pointer@1" },
    "targetId": { "type": "string", "pattern": "^s2:w:[0-9a-f]{16}$" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "outcome",
        "dispatchState",
        "coordinateSpace",
        "stepCount",
        "completedSteps",
        "legacyClickCompatibility",
        "buttonOwnership",
        "buttonsHeldByTool",
        "safeReleaseAttempted",
        "safeReleaseSucceeded",
        "targetReresolvedBeforeEveryPoint",
        "targetHitTestedBeforeContact",
        "coordinateValidatedAtUse",
        "coordinateContext",
        "signedVirtualScreenCoordinates",
        "targetRestored",
        "targetActivated",
        "foregroundChangedDuringDispatch",
        "permissionPreflight",
        "activeWriteProbePerformed",
        "confirmationEvaluatedBeforeDispatch",
        "foregroundConsentEvaluatedBeforeDispatch",
        "retrySafe",
        "automaticRetryProhibited"
      ],
      "properties": {
        "capability": { "const": "ui.input.pointer@1" },
        "outcome": { "const": "completed" },
        "dispatchState": { "const": "completed" },
        "coordinateSpace": { "enum": ["screen-physical-px", "window-client-physical-px"] },
        "stepCount": { "type": "integer", "minimum": 1, "maximum": 64 },
        "completedSteps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["index", "type", "status"],
            "properties": {
              "index": { "type": "integer", "minimum": 0, "maximum": 63 },
              "type": { "enum": ["move", "button", "click", "scroll", "drag"] },
              "status": { "const": "completed" }
            }
          }
        },
        "legacyClickCompatibility": { "type": "boolean" },
        "buttonOwnership": { "const": "request-scoped-balanced" },
        "buttonsHeldByTool": { "type": "array", "maxItems": 0 },
        "safeReleaseAttempted": { "const": false },
        "safeReleaseSucceeded": { "const": true },
        "targetReresolvedBeforeEveryPoint": { "const": true },
        "targetHitTestedBeforeContact": { "const": true },
        "coordinateValidatedAtUse": { "const": true },
        "coordinateContext": { "const": "per-monitor-v2-physical-px" },
        "signedVirtualScreenCoordinates": { "const": true },
        "targetRestored": { "type": "boolean" },
        "targetActivated": { "const": true },
        "foregroundChangedDuringDispatch": { "const": false },
        "permissionPreflight": { "const": "no-static-integrity-block-observed" },
        "activeWriteProbePerformed": { "const": false },
        "confirmationEvaluatedBeforeDispatch": { "const": true },
        "foregroundConsentEvaluatedBeforeDispatch": { "const": true },
        "retrySafe": { "const": false },
        "automaticRetryProhibited": { "const": true }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["foreground", "targeting"],
      "properties": {
        "foreground": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unchanged"],
          "properties": { "unchanged": { "type": "boolean" } }
        },
        "targeting": { "const": "opaque exact session" }
      }
    }
  }
}
