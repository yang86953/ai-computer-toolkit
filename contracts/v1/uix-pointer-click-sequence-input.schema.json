{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://ui/pointer-click-sequence/v1",
  "title": "UIX cooperative application-internal pointer click sequence input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["coordinateSpace", "clicks"],
  "properties": {
    "coordinateSpace": { "const": "client-logical-px" },
    "clicks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/point" }
    },
    "intervalMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 500,
      "default": 0
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 100,
      "maximum": 30000,
      "default": 30000,
      "description": "Rust validation additionally requires timeoutMs >= (clicks.length - 1) * intervalMs + 100."
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 65535,
          "description": "The coordinate must be finite."
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 65535,
          "description": "The coordinate must be finite."
        }
      }
    }
  }
}
