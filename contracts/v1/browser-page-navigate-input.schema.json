{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://browser/page-navigate/v1",
  "title": "Provider-neutral browser page navigation input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["url"],
  "properties": {
    "url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^https?://[^\\s\\\\@]+$"
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30000,
      "default": 5000
    }
  }
}
