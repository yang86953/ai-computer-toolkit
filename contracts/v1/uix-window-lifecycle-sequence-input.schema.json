{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://window/lifecycle-sequence/v1",
  "title": "UIX cooperative window lifecycle sequence input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["actions"],
  "properties": {
    "actions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/action" },
      "description": "Rust validation additionally requires at least two distinct action types."
    },
    "intervalMs": { "type": "integer", "minimum": 0, "maximum": 500, "default": 0 },
    "timeoutMs": {
      "type": "integer",
      "minimum": 100,
      "maximum": 30000,
      "default": 30000,
      "description": "Rust validation additionally requires timeoutMs >= (actions.length - 1) * intervalMs + 100."
    }
  },
  "$defs": {
    "simpleAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": { "type": { "enum": ["restore", "minimize", "maximize"] } }
    },
    "resizeAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinateSpace", "width", "height"],
      "properties": {
        "type": { "const": "resize" },
        "coordinateSpace": { "const": "client-logical-px" },
        "width": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "height": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "action": {
      "oneOf": [
        { "$ref": "#/$defs/simpleAction" },
        { "$ref": "#/$defs/resizeAction" }
      ]
    }
  }
}
