{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://browser/element-type/v1",
  "title": "Provider-neutral browser element type input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["pageId", "elementId", "text", "replace"],
  "properties": {
    "pageId": { "$ref": "#/$defs/browserPageId" },
    "elementId": { "$ref": "#/$defs/browserElementId" },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "replace": { "type": "boolean" },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30000,
      "default": 5000
    }
  },
  "$defs": {
    "browserPageId": {
      "type": "string",
      "pattern": "^s2:bp:[0-9a-f]{32}$"
    },
    "browserElementId": {
      "type": "string",
      "pattern": "^s2:be:[0-9a-f]{32}$"
    }
  }
}
