{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://ui/input-sequence-transition/v1",
  "title": "UIX cooperative application-internal key and pointer sequence transition input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["coordinateSpace", "steps", "postcondition"],
  "properties": {
    "coordinateSpace": { "const": "client-logical-px" },
    "steps": {
      "type": "array",
      "minItems": 2,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/step" },
      "description": "Rust validation additionally requires at least one press and at least one pointer move or click."
    },
    "intervalMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 500,
      "default": 0
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 100,
      "maximum": 30000,
      "default": 30000,
      "description": "Rust validation additionally requires timeoutMs >= (steps.length - 1) * intervalMs + 100."
    },
    "postcondition": { "$ref": "#/$defs/postcondition" }
  },
  "allOf": [
    {
      "properties": {
        "steps": {
          "contains": { "$ref": "#/$defs/press" }
        }
      },
      "required": ["steps"]
    },
    {
      "properties": {
        "steps": {
          "contains": { "$ref": "#/$defs/pointer" }
        }
      },
      "required": ["steps"]
    }
  ],
  "$defs": {
    "keyName": {
      "oneOf": [
        { "type": "string", "pattern": "^[a-z0-9]$" },
        { "type": "string", "pattern": "^f([1-9]|1[0-2])$" },
        {
          "enum": [
            "enter", "tab", "escape", "backspace", "delete", "insert", "space",
            "left", "up", "right", "down", "home", "end", "page-up", "page-down",
            "control", "alt", "shift", "super"
          ]
        }
      ]
    },
    "press": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "key"],
      "properties": {
        "type": { "const": "press" },
        "key": { "$ref": "#/$defs/keyName" },
        "modifiers": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["alt", "control", "shift", "super"] },
          "default": []
        }
      }
    },
    "pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "x", "y"],
      "properties": {
        "type": { "enum": ["move", "click"] },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 65535,
          "description": "The coordinate must be finite."
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 65535,
          "description": "The coordinate must be finite."
        }
      }
    },
    "step": {
      "oneOf": [
        { "$ref": "#/$defs/press" },
        { "$ref": "#/$defs/pointer" }
      ]
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "automationId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "role": { "type": "string", "minLength": 1, "maxLength": 64 },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "focused": { "type": "boolean" },
        "enabled": { "type": "boolean" },
        "action": { "type": "string", "minLength": 1, "maxLength": 64 }
      },
      "anyOf": [
        { "required": ["automationId"] },
        { "required": ["role"] },
        { "required": ["name"] },
        { "required": ["focused"] },
        { "required": ["enabled"] },
        { "required": ["action"] }
      ]
    },
    "postcondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "condition"],
      "properties": {
        "selector": { "$ref": "#/$defs/selector" },
        "condition": { "enum": ["unique", "missing"] }
      }
    }
  }
}
