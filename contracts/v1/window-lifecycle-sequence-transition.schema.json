{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://window/lifecycle-sequence-transition-result/v1",
  "title": "UIX cooperative window lifecycle sequence transition result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "app",
    "verb",
    "capability",
    "targetId",
    "executionRealm",
    "requiredExecutionRealm",
    "executionRealmCertified",
    "isolationRequirement",
    "hostImpactPolicy",
    "data",
    "meta"
  ],
  "properties": {
    "ok": { "const": true },
    "app": { "const": "app" },
    "verb": { "const": "apply" },
    "capability": { "const": "window.lifecycle.sequence.transition@1" },
    "targetId": { "$ref": "#/$defs/windowTarget" },
    "executionRealm": { "const": "host-foreground" },
    "requiredExecutionRealm": { "const": "host-foreground" },
    "executionRealmCertified": { "const": true },
    "isolationRequirement": { "const": "standard" },
    "hostImpactPolicy": { "const": "background-preferred" },
    "data": { "$ref": "#/$defs/data" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["foreground", "targeting"],
      "properties": {
        "foreground": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "activationRequested",
            "visibleMutationAuthorized",
            "frameworkConditionObservationRequested"
          ],
          "properties": {
            "activationRequested": { "const": false },
            "visibleMutationAuthorized": { "const": true },
            "frameworkConditionObservationRequested": { "const": true }
          }
        },
        "targeting": { "const": "opaque exact window generation" }
      }
    }
  },
  "$defs": {
    "windowTarget": {
      "type": "string",
      "pattern": "^s2:w:[0-9a-f]{16}$"
    },
    "simpleAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["restore", "minimize", "maximize"] }
      }
    },
    "resizeAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinateSpace", "width", "height"],
      "properties": {
        "type": { "const": "resize" },
        "coordinateSpace": { "const": "client-logical-px" },
        "width": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "height": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "action": {
      "oneOf": [
        { "$ref": "#/$defs/simpleAction" },
        { "$ref": "#/$defs/resizeAction" }
      ]
    },
    "visibilityCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "visibility" },
        "visible": { "type": "boolean" },
        "presentable": { "type": "boolean" }
      },
      "anyOf": [
        { "required": ["visible"] },
        { "required": ["presentable"] }
      ]
    },
    "focusCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "focused"],
      "properties": {
        "type": { "const": "focus" },
        "focused": { "type": "boolean" }
      }
    },
    "clientSizeCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "width", "height"],
      "properties": {
        "type": { "const": "client-size" },
        "width": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "height": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "windowFlagsCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "window-flags" },
        "maximized": { "type": "boolean" },
        "minimized": { "type": "boolean" },
        "fullscreen": { "type": "boolean" }
      },
      "anyOf": [
        { "required": ["maximized"] },
        { "required": ["minimized"] },
        { "required": ["fullscreen"] }
      ]
    },
    "condition": {
      "oneOf": [
        { "$ref": "#/$defs/visibilityCondition" },
        { "$ref": "#/$defs/focusCondition" },
        { "$ref": "#/$defs/clientSizeCondition" },
        { "$ref": "#/$defs/windowFlagsCondition" }
      ]
    },
    "clientSize": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "height": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
      }
    },
    "windowState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximized", "minimized", "fullscreen"],
      "properties": {
        "maximized": { "type": "boolean" },
        "minimized": { "type": "boolean" },
        "fullscreen": { "type": "boolean" }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "sameAuthenticatedConnectionUsed",
        "windowGenerationFixed",
        "revisionChainUsed",
        "providerPolling",
        "waitProtocolUsed",
        "desktopInputInjected",
        "desktopPointerMoved",
        "arbitraryWindowMoveSupported",
        "nativeIdentityExposed",
        "transportIdentityExposed",
        "x11Used",
        "fallback"
      ],
      "properties": {
        "provider": { "const": "uix-agent-v1" },
        "sameAuthenticatedConnectionUsed": { "const": true },
        "windowGenerationFixed": { "const": true },
        "revisionChainUsed": { "const": true },
        "providerPolling": { "const": true },
        "waitProtocolUsed": { "const": false },
        "desktopInputInjected": { "const": false },
        "desktopPointerMoved": { "const": false },
        "arbitraryWindowMoveSupported": { "const": false },
        "nativeIdentityExposed": { "const": false },
        "transportIdentityExposed": { "const": false },
        "x11Used": { "const": false },
        "fallback": { "const": "none" }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "targetId",
        "action",
        "actions",
        "actionsRequested",
        "actionsAccepted",
        "distinctActionKinds",
        "intervalMs",
        "plannedDurationMs",
        "sequenceRevision",
        "sequencePresentedRevision",
        "sequenceSettled",
        "condition",
        "observationSource",
        "coordinateSpace",
        "visible",
        "presentable",
        "focused",
        "clientSize",
        "windowState",
        "outcome",
        "dispatchState",
        "accepted",
        "frameworkConditionMatchedAfterCompleteSequence",
        "revision",
        "presentedRevision",
        "pollCount",
        "sameAuthenticatedConnectionUsed",
        "sameConnectionRevisionChain",
        "providerPolling",
        "waitProtocolUsed",
        "transactionSemantics",
        "rollbackSemantics",
        "effectConfirmed",
        "finalStateReached",
        "causalityConfirmed",
        "compositorFinalStateConfirmed",
        "windowReResolved",
        "applicationPolicyEvaluated",
        "confirmationEvaluatedBeforeDiscovery",
        "foregroundConsentEvaluatedBeforeDiscovery",
        "foregroundConsentRequired",
        "foregroundImpactAuthorized",
        "hostForegroundActivationRequested",
        "effectObservation",
        "automaticRetryProhibited",
        "retrySafe",
        "pollIntervalMs",
        "timeoutMs",
        "executionRealm",
        "safety"
      ],
      "properties": {
        "capability": { "const": "window.lifecycle.sequence.transition@1" },
        "targetId": { "$ref": "#/$defs/windowTarget" },
        "action": { "const": "lifecycle-sequence" },
        "actions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/action" },
          "description": "Rust validation additionally requires at least two distinct action types."
        },
        "actionsRequested": { "type": "integer", "minimum": 2, "maximum": 16 },
        "actionsAccepted": { "type": "integer", "minimum": 2, "maximum": 16 },
        "distinctActionKinds": { "type": "integer", "minimum": 2, "maximum": 4 },
        "intervalMs": { "type": "integer", "minimum": 0, "maximum": 500 },
        "plannedDurationMs": { "type": "integer", "minimum": 0, "maximum": 5000 },
        "sequenceRevision": { "type": "integer", "minimum": 0 },
        "sequencePresentedRevision": { "type": "integer", "minimum": 0 },
        "sequenceSettled": { "type": "boolean" },
        "condition": { "$ref": "#/$defs/condition" },
        "observationSource": { "const": "uix-framework-current" },
        "coordinateSpace": { "const": "client-logical-px" },
        "visible": { "type": "boolean" },
        "presentable": { "type": "boolean" },
        "focused": { "type": "boolean" },
        "clientSize": { "$ref": "#/$defs/clientSize" },
        "windowState": { "$ref": "#/$defs/windowState" },
        "outcome": { "const": "completed" },
        "dispatchState": { "const": "completed" },
        "accepted": { "const": true },
        "frameworkConditionMatchedAfterCompleteSequence": { "const": true },
        "revision": { "type": "integer", "minimum": 0 },
        "presentedRevision": { "type": "integer", "minimum": 0 },
        "pollCount": { "type": "integer", "minimum": 1, "maximum": 1501 },
        "sameAuthenticatedConnectionUsed": { "const": true },
        "sameConnectionRevisionChain": { "const": true },
        "providerPolling": { "const": true },
        "waitProtocolUsed": { "const": false },
        "transactionSemantics": { "const": false },
        "rollbackSemantics": { "const": false },
        "effectConfirmed": { "const": false },
        "finalStateReached": { "const": false },
        "causalityConfirmed": { "const": false },
        "compositorFinalStateConfirmed": { "const": false },
        "windowReResolved": { "const": true },
        "applicationPolicyEvaluated": { "const": true },
        "confirmationEvaluatedBeforeDiscovery": { "const": true },
        "foregroundConsentEvaluatedBeforeDiscovery": { "const": true },
        "foregroundConsentRequired": { "const": true },
        "foregroundImpactAuthorized": { "const": true },
        "hostForegroundActivationRequested": { "const": false },
        "effectObservation": {
          "const": "framework-condition-after-complete-sequence-no-causal-claim"
        },
        "automaticRetryProhibited": { "const": true },
        "retrySafe": { "const": false },
        "pollIntervalMs": { "type": "integer", "minimum": 20, "maximum": 500 },
        "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 30000 },
        "executionRealm": { "const": "host-foreground" },
        "safety": { "$ref": "#/$defs/safety" }
      }
    }
  }
}
