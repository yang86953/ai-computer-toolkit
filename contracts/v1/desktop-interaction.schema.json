{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://desktop/interaction/v1",
  "title": "Bounded observed desktop interaction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "steps"
  ],
  "properties": {
    "frameId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30000,
      "default": 30000
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "keys"
            ],
            "properties": {
              "type": {
                "const": "key"
              },
              "keys": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/keyName"
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "text"
            ],
            "properties": {
              "type": {
                "const": "text"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^[ -~]+$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "x",
              "y"
            ],
            "properties": {
              "type": {
                "const": "click"
              },
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 16383
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 16383
              },
              "button": {
                "enum": [
                  "left",
                  "right",
                  "middle"
                ],
                "default": "left"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "x",
              "y"
            ],
            "properties": {
              "type": {
                "const": "move"
              },
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 16383
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 16383
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "ms"
            ],
            "properties": {
              "type": {
                "const": "wait"
              },
              "ms": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "keyName": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9]$"
        },
        {
          "type": "string",
          "pattern": "^f([1-9]|1[0-9]|2[0-4])$"
        },
        {
          "type": "string",
          "pattern": "^numpad-[0-9]$"
        },
        {
          "enum": [
            "enter",
            "tab",
            "escape",
            "backspace",
            "delete",
            "insert",
            "space",
            "left",
            "up",
            "right",
            "down",
            "home",
            "end",
            "page-up",
            "page-down",
            "left-control",
            "right-control",
            "left-alt",
            "right-alt",
            "left-shift",
            "right-shift",
            "left-win",
            "right-win",
            "numpad-add",
            "numpad-subtract",
            "numpad-multiply",
            "numpad-divide",
            "numpad-decimal",
            "numpad-enter",
            "minus",
            "equals",
            "left-bracket",
            "right-bracket",
            "backslash",
            "semicolon",
            "apostrophe",
            "grave",
            "comma",
            "period",
            "slash",
            "caps-lock",
            "num-lock",
            "scroll-lock",
            "print-screen",
            "pause",
            "menu",
            "volume-mute",
            "volume-down",
            "volume-up",
            "media-next",
            "media-previous",
            "media-stop",
            "media-play-pause"
          ]
        }
      ]
    }
  }
}
