{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://window/close-transition/v1/result",
  "title": "UIX exact window close transition result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok", "app", "verb", "capability", "targetId", "executionRealm",
    "requiredExecutionRealm", "executionRealmCertified", "isolationRequirement",
    "hostImpactPolicy", "data", "meta"
  ],
  "properties": {
    "ok": { "const": true },
    "app": { "const": "app" },
    "verb": { "const": "close" },
    "capability": { "const": "window.close.transition@1" },
    "targetId": { "$ref": "#/$defs/windowTarget" },
    "executionRealm": { "const": "same-session-no-focus" },
    "requiredExecutionRealm": { "const": "same-session-no-focus" },
    "executionRealmCertified": { "const": true },
    "isolationRequirement": { "const": "standard" },
    "hostImpactPolicy": { "const": "background-preferred" },
    "data": { "$ref": "#/$defs/data" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["foreground", "targeting"],
      "properties": {
        "foreground": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "activationRequested",
            "terminalClosedObservationRequested"
          ],
          "properties": {
            "activationRequested": { "const": false },
            "terminalClosedObservationRequested": { "const": true }
          }
        },
        "targeting": { "const": "opaque exact window generation" }
      }
    }
  },
  "$defs": {
    "windowTarget": {
      "type": "string",
      "pattern": "^s2:w:[0-9a-f]{16}$"
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider", "providerCache", "sameAuthenticatedConnectionUsed",
        "windowGenerationFixed", "waitProtocolUsed", "providerPolling",
        "terminalReplyReceived", "connectionCloseAcceptedAsProof",
        "nativeIdentityExposed", "transportIdentityExposed",
        "hostForegroundActivationRequested", "desktopInputInjected",
        "windowInventoryPolled", "x11Used", "fallback"
      ],
      "properties": {
        "provider": { "const": "uix-agent-v1" },
        "providerCache": { "const": "disabled" },
        "sameAuthenticatedConnectionUsed": { "const": true },
        "windowGenerationFixed": { "const": true },
        "waitProtocolUsed": { "const": true },
        "providerPolling": { "const": false },
        "terminalReplyReceived": { "const": true },
        "connectionCloseAcceptedAsProof": { "const": false },
        "nativeIdentityExposed": { "const": false },
        "transportIdentityExposed": { "const": false },
        "hostForegroundActivationRequested": { "const": false },
        "desktopInputInjected": { "const": false },
        "windowInventoryPolled": { "const": false },
        "x11Used": { "const": false },
        "fallback": { "const": "none" }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok", "contractVersion", "capability", "targetId", "outcome",
        "dispatchState", "accepted", "actionAccepted", "actionRevision",
        "actionPresentedRevision", "actionSettled", "revision",
        "presentedRevision", "closed", "closeConfirmed", "exactGenerationConfirmed",
        "closedObservedAfterDispatch", "causalityConfirmed",
        "applicationClosedConfirmed", "finalStateReached", "effectObservation",
        "sameAuthenticatedConnectionUsed", "waitProtocolUsed", "providerPolling",
        "windowReResolved", "applicationPolicyEvaluated",
        "confirmationEvaluatedBeforeDiscovery", "automaticRetryProhibited",
        "retrySafe", "timeoutMs", "executionRealm", "readOnly", "mutationAllowed",
        "safety"
      ],
      "properties": {
        "ok": { "const": true },
        "contractVersion": { "const": "act/window-close-transition/v1" },
        "capability": { "const": "window.close.transition@1" },
        "targetId": { "$ref": "#/$defs/windowTarget" },
        "outcome": { "const": "closed" },
        "dispatchState": { "const": "completed" },
        "accepted": { "const": true },
        "actionAccepted": { "const": true },
        "actionRevision": { "type": "integer", "minimum": 0 },
        "actionPresentedRevision": { "type": "integer", "minimum": 0 },
        "actionSettled": { "type": "boolean" },
        "revision": { "type": "integer", "minimum": 0 },
        "presentedRevision": { "type": "integer", "minimum": 0 },
        "closed": { "const": true },
        "closeConfirmed": { "const": true },
        "exactGenerationConfirmed": { "const": true },
        "closedObservedAfterDispatch": { "const": true },
        "causalityConfirmed": { "const": false },
        "applicationClosedConfirmed": { "const": false },
        "finalStateReached": { "const": true },
        "effectObservation": {
          "const": "same-connection-exact-generation-closed-after-dispatch-no-causal-claim"
        },
        "sameAuthenticatedConnectionUsed": { "const": true },
        "waitProtocolUsed": { "const": true },
        "providerPolling": { "const": false },
        "windowReResolved": { "const": true },
        "applicationPolicyEvaluated": { "const": true },
        "confirmationEvaluatedBeforeDiscovery": { "const": true },
        "automaticRetryProhibited": { "const": true },
        "retrySafe": { "const": false },
        "timeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 30000
        },
        "executionRealm": { "const": "same-session-no-focus" },
        "readOnly": { "const": false },
        "mutationAllowed": { "const": true },
        "safety": { "$ref": "#/$defs/safety" }
      }
    }
  }
}
