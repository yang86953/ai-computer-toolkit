{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://ui/pointer-drag/v1",
  "title": "UIX cooperative application-internal pointer drag input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["coordinateSpace", "start", "end"],
  "properties": {
    "coordinateSpace": { "const": "client-logical-px" },
    "start": { "$ref": "#/$defs/point" },
    "end": { "$ref": "#/$defs/point" },
    "samples": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64,
      "default": 12
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5000,
      "default": 250
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 100,
      "maximum": 30000,
      "default": 30000,
      "description": "Rust validation additionally requires timeoutMs >= durationMs + 100."
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 65535,
          "description": "The coordinate must be finite."
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 65535,
          "description": "The coordinate must be finite."
        }
      }
    }
  }
}
