{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://ui/pointer-sequence/v1",
  "title": "UIX cooperative application-internal pointer sequence input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["coordinateSpace", "steps"],
  "properties": {
    "coordinateSpace": { "const": "client-logical-px" },
    "steps": {
      "type": "array",
      "minItems": 2,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/step" },
      "description": "Rust validation additionally requires at least one move and one click."
    },
    "intervalMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 500,
      "default": 0
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 100,
      "maximum": 30000,
      "default": 30000,
      "description": "Rust validation additionally requires timeoutMs >= (steps.length - 1) * intervalMs + 100."
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 65535,
          "description": "The coordinate must be finite."
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 65535,
          "description": "The coordinate must be finite."
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "x", "y"],
      "properties": {
        "type": { "enum": ["move", "click"] },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 65535,
          "description": "The coordinate must be finite."
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 65535,
          "description": "The coordinate must be finite."
        }
      }
    }
  }
}
