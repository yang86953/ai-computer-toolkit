{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://window/lifecycle-sequence-transition/v1",
  "title": "UIX cooperative window lifecycle sequence transition input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["actions", "condition"],
  "properties": {
    "actions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/action" },
      "description": "Rust validation additionally requires at least two distinct action types."
    },
    "intervalMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 500,
      "default": 0
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 100,
      "maximum": 30000,
      "default": 30000,
      "description": "Rust validation additionally requires timeoutMs >= (actions.length - 1) * intervalMs + 100."
    },
    "condition": { "$ref": "#/$defs/condition" },
    "pollIntervalMs": {
      "type": "integer",
      "minimum": 20,
      "maximum": 500,
      "default": 50
    }
  },
  "$defs": {
    "simpleAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["restore", "minimize", "maximize"] }
      }
    },
    "resizeAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinateSpace", "width", "height"],
      "properties": {
        "type": { "const": "resize" },
        "coordinateSpace": { "const": "client-logical-px" },
        "width": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "height": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "action": {
      "oneOf": [
        { "$ref": "#/$defs/simpleAction" },
        { "$ref": "#/$defs/resizeAction" }
      ]
    },
    "visibilityCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "visibility" },
        "visible": { "type": "boolean" },
        "presentable": { "type": "boolean" }
      },
      "anyOf": [
        { "required": ["visible"] },
        { "required": ["presentable"] }
      ]
    },
    "focusCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "focused"],
      "properties": {
        "type": { "const": "focus" },
        "focused": { "type": "boolean" }
      }
    },
    "clientSizeCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "width", "height"],
      "properties": {
        "type": { "const": "client-size" },
        "width": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "height": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "windowFlagsCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "window-flags" },
        "maximized": { "type": "boolean" },
        "minimized": { "type": "boolean" },
        "fullscreen": { "type": "boolean" }
      },
      "anyOf": [
        { "required": ["maximized"] },
        { "required": ["minimized"] },
        { "required": ["fullscreen"] }
      ]
    },
    "condition": {
      "oneOf": [
        { "$ref": "#/$defs/visibilityCondition" },
        { "$ref": "#/$defs/focusCondition" },
        { "$ref": "#/$defs/clientSizeCondition" },
        { "$ref": "#/$defs/windowFlagsCondition" }
      ]
    }
  }
}
