{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://ui/key-sequence-result/v1",
  "title": "UIX cooperative application-internal key sequence result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "app",
    "verb",
    "capability",
    "targetId",
    "executionRealm",
    "requiredExecutionRealm",
    "executionRealmCertified",
    "isolationRequirement",
    "hostImpactPolicy",
    "data",
    "meta"
  ],
  "properties": {
    "ok": { "const": true },
    "app": { "const": "app" },
    "verb": { "const": "apply" },
    "capability": { "const": "ui.input.key.sequence@1" },
    "targetId": { "$ref": "#/$defs/windowTarget" },
    "executionRealm": { "const": "same-session-no-focus" },
    "requiredExecutionRealm": { "const": "same-session-no-focus" },
    "executionRealmCertified": { "const": true },
    "isolationRequirement": { "const": "standard" },
    "hostImpactPolicy": { "const": "background-preferred" },
    "data": { "$ref": "#/$defs/data" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["foreground", "targeting"],
      "properties": {
        "foreground": {
          "type": "object",
          "additionalProperties": false,
          "required": ["activationRequested"],
          "properties": { "activationRequested": { "const": false } }
        },
        "targeting": { "const": "opaque exact window generation" }
      }
    }
  },
  "$defs": {
    "windowTarget": {
      "type": "string",
      "pattern": "^s2:w:[0-9a-f]{16}$"
    },
    "keyName": {
      "oneOf": [
        { "type": "string", "pattern": "^[a-z0-9]$" },
        { "type": "string", "pattern": "^f([1-9]|1[0-2])$" },
        {
          "enum": [
            "enter", "tab", "escape", "backspace", "delete", "insert", "space",
            "left", "up", "right", "down", "home", "end", "page-up", "page-down",
            "control", "alt", "shift", "super"
          ]
        }
      ]
    },
    "keyPress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "key": { "$ref": "#/$defs/keyName" },
        "modifiers": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["control", "alt", "shift", "super"] }
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "targetId",
        "action",
        "presses",
        "pressesRequested",
        "pressesAccepted",
        "intervalMs",
        "plannedDurationMs",
        "outcome",
        "dispatchState",
        "accepted",
        "allPressesBalanced",
        "revision",
        "presentedRevision",
        "settled",
        "effectConfirmed",
        "finalStateReached",
        "windowReResolved",
        "applicationPolicyEvaluated",
        "confirmationEvaluatedBeforeDiscovery",
        "foregroundConsentRequired",
        "hostForegroundActivationRequested",
        "automaticRetryProhibited",
        "retrySafe",
        "timeoutMs",
        "executionRealm",
        "safety"
      ],
      "properties": {
        "capability": { "const": "ui.input.key.sequence@1" },
        "targetId": { "$ref": "#/$defs/windowTarget" },
        "action": { "const": "key-sequence" },
        "presses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/keyPress" }
        },
        "pressesRequested": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "pressesAccepted": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "intervalMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "plannedDurationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "outcome": { "const": "completed" },
        "dispatchState": { "const": "completed" },
        "accepted": { "const": true },
        "allPressesBalanced": { "const": true },
        "revision": { "type": "integer", "minimum": 0 },
        "presentedRevision": { "type": "integer", "minimum": 0 },
        "settled": { "type": "boolean" },
        "effectConfirmed": { "const": false },
        "finalStateReached": { "const": false },
        "windowReResolved": { "const": true },
        "applicationPolicyEvaluated": { "const": true },
        "confirmationEvaluatedBeforeDiscovery": { "const": true },
        "foregroundConsentRequired": { "const": false },
        "hostForegroundActivationRequested": { "const": false },
        "automaticRetryProhibited": { "const": true },
        "retrySafe": { "const": false },
        "timeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 30000
        },
        "executionRealm": { "const": "same-session-no-focus" },
        "safety": { "$ref": "#/$defs/safety" }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "applicationInternalEventsDispatched",
        "desktopInputInjected",
        "requestScopedBalancedPresses",
        "textInputSupported",
        "keyHoldSupported",
        "keyRepeatSupported",
        "nativeIdentityExposed",
        "transportIdentityExposed",
        "x11Used",
        "fallback"
      ],
      "properties": {
        "provider": { "const": "uix-agent-v1" },
        "applicationInternalEventsDispatched": { "const": true },
        "desktopInputInjected": { "const": false },
        "requestScopedBalancedPresses": { "const": true },
        "textInputSupported": { "const": false },
        "keyHoldSupported": { "const": false },
        "keyRepeatSupported": { "const": false },
        "nativeIdentityExposed": { "const": false },
        "transportIdentityExposed": { "const": false },
        "x11Used": { "const": false },
        "fallback": { "const": "none" }
      }
    }
  }
}
