{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-computer-toolkit/contracts/v1/accessibility-tree.schema.json",
  "title": "Job-isolated bounded accessibility tree",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability",
    "session",
    "scope",
    "view",
    "readOnly",
    "foregroundUnchanged",
    "maximumDepth",
    "maximumItems",
    "visited",
    "truncated",
    "nodes",
    "safety"
  ],
  "properties": {
    "executionRealm": { "enum": ["host-headless", "host-background", "same-session-no-focus", "isolated-worker", "host-foreground", "none"] },
    "requiredExecutionRealm": { "enum": ["host-headless", "host-background", "same-session-no-focus", "isolated-worker", "host-foreground", "none"] },
    "executionRealmCertified": { "type": "boolean" },
    "isolationRequirement": { "enum": ["standard", "strict"] },
    "hostImpactPolicy": { "enum": ["background-preferred", "strict-no-interference"] },
    "capability": { "const": "accessibility.tree.read@1" },
    "session": { "$ref": "#/$defs/windowSession" },
    "scope": { "const": "bounded-tree" },
    "view": { "enum": ["control", "raw"] },
    "readOnly": { "const": true },
    "foregroundUnchanged": { "const": true },
    "maximumDepth": { "type": "integer", "minimum": 0, "maximum": 20 },
    "maximumItems": { "type": "integer", "minimum": 1, "maximum": 4096 },
    "visited": { "type": "integer", "minimum": 0, "maximum": 4096 },
    "truncated": { "type": "boolean" },
    "nodes": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/node" }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valueContentRead",
        "textContentRead",
        "writePatternsQueried",
        "boundsExposed",
        "providerTimeoutIsolation",
        "workerTimeoutMs",
        "workerCancellable"
      ],
      "properties": {
        "valueContentRead": { "const": false },
        "textContentRead": { "const": false },
        "writePatternsQueried": { "const": false },
        "boundsExposed": { "const": false },
        "providerTimeoutIsolation": { "const": "job-bounded-worker" },
        "workerTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "workerCancellable": { "const": true }
      }
    }
  },
  "$defs": {
    "windowSession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "kind",
        "targetKind",
        "applicationName",
        "title",
        "visible",
        "capabilities"
      ],
      "properties": {
        "sessionId": {
          "type": "string",
          "pattern": "^s2:w:[0-9a-f]{16}$"
        },
        "kind": { "const": "window" },
        "targetKind": { "const": "application-window" },
        "applicationName": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "visible": { "const": true },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "propertyNames": {
              "not": {
                "enum": [
                  "hwnd",
                  "processId",
                  "nativeHandle",
                  "bounds",
                  "path",
                  "providerId"
                ]
              }
            }
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "identityFreshness",
        "depth",
        "name",
        "automationId",
        "className",
        "frameworkId",
        "controlType",
        "enabled",
        "offscreen",
        "propertyReadComplete"
      ],
      "properties": {
        "nodeId": {
          "type": "string",
          "pattern": "^s2:e:[0-9a-f]{16}$"
        },
        "identityFreshness": { "const": "inspection-snapshot" },
        "depth": { "type": "integer", "minimum": 0, "maximum": 20 },
        "name": { "type": "string" },
        "automationId": { "type": "string" },
        "className": { "type": "string" },
        "frameworkId": { "type": "string" },
        "controlType": { "type": "integer" },
        "enabled": { "type": "boolean" },
        "offscreen": { "type": "boolean" },
        "propertyReadComplete": { "type": "boolean" }
      }
    }
  }
}
