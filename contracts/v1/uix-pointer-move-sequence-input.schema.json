{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://ui/pointer-move-sequence/v1",
  "title": "UIX cooperative application-internal pointer move sequence input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["coordinateSpace", "moves"],
  "properties": {
    "coordinateSpace": { "const": "client-logical-px" },
    "moves": {
      "type": "array",
      "minItems": 2,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/point" }
    },
    "intervalMs": { "type": "integer", "minimum": 0, "maximum": 500, "default": 0 },
    "timeoutMs": {
      "type": "integer",
      "minimum": 100,
      "maximum": 30000,
      "default": 30000,
      "description": "Rust validation additionally requires timeoutMs >= (moves.length - 1) * intervalMs + 100."
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 65535 },
        "y": { "type": "number", "minimum": 0, "maximum": 65535 }
      }
    }
  }
}
