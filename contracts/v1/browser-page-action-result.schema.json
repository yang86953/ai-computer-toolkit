{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-computer-toolkit/contracts/v1/browser-page-action-result.schema.json",
  "title": "Provider-neutral browser element action and page screenshot success result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "executionRealm",
    "requiredExecutionRealm",
    "executionRealmCertified",
    "isolationRequirement",
    "hostImpactPolicy",
    "ok",
    "app",
    "verb",
    "capability",
    "targetId",
    "data",
    "meta"
  ],
  "oneOf": [
    {
      "properties": {
        "verb": { "const": "apply" },
        "capability": { "const": "browser.element.click@1" },
        "isolationRequirement": { "const": "strict" },
        "hostImpactPolicy": { "const": "strict-no-interference" },
        "data": { "$ref": "#/$defs/clickData" }
      }
    },
    {
      "properties": {
        "verb": { "const": "apply" },
        "capability": { "const": "browser.element.type@1" },
        "isolationRequirement": { "const": "strict" },
        "hostImpactPolicy": { "const": "strict-no-interference" },
        "data": { "$ref": "#/$defs/typeData" }
      }
    },
    {
      "properties": {
        "verb": { "const": "read" },
        "capability": { "const": "browser.page.screenshot@1" },
        "isolationRequirement": { "const": "standard" },
        "hostImpactPolicy": { "const": "background-preferred" },
        "data": { "$ref": "#/$defs/screenshotData" }
      }
    }
  ],
  "properties": {
    "executionRealm": { "const": "isolated-worker" },
    "requiredExecutionRealm": { "const": "isolated-worker" },
    "executionRealmCertified": { "const": true },
    "isolationRequirement": { "enum": ["standard", "strict"] },
    "hostImpactPolicy": { "enum": ["background-preferred", "strict-no-interference"] },
    "ok": { "const": true },
    "app": { "const": "app" },
    "verb": { "enum": ["apply", "read"] },
    "capability": {
      "enum": ["browser.element.click@1", "browser.element.type@1", "browser.page.screenshot@1"]
    },
    "targetId": { "$ref": "#/$defs/browserSessionId" },
    "data": {
      "oneOf": [
        { "$ref": "#/$defs/clickData" },
        { "$ref": "#/$defs/typeData" },
        { "$ref": "#/$defs/screenshotData" }
      ]
    },
    "meta": { "$ref": "#/$defs/meta" }
  },
  "$defs": {
    "browserSessionId": {
      "type": "string",
      "pattern": "^s2:bs:[0-9a-f]{32}$"
    },
    "browserPageId": {
      "type": "string",
      "pattern": "^s2:bp:[0-9a-f]{32}$"
    },
    "browserElementId": {
      "type": "string",
      "pattern": "^s2:be:[0-9a-f]{32}$"
    },
    "commandCommon": {
      "type": "object",
      "required": [
        "outcome",
        "dispatchState",
        "accepted",
        "finalStateReached",
        "targetMayHaveMutated",
        "foregroundUnchanged",
        "confirmationEvaluatedBeforeDispatch",
        "foregroundConsentEvaluatedBeforeDispatch",
        "retrySafe",
        "automaticRetryProhibited"
      ],
      "properties": {
        "outcome": { "const": "completed" },
        "dispatchState": { "const": "completed" },
        "accepted": { "const": true },
        "finalStateReached": { "const": true },
        "targetMayHaveMutated": { "const": true },
        "foregroundUnchanged": { "const": true },
        "confirmationEvaluatedBeforeDispatch": { "const": true },
        "foregroundConsentEvaluatedBeforeDispatch": { "const": true },
        "retrySafe": { "const": false },
        "automaticRetryProhibited": { "const": true }
      }
    },
    "queryCommon": {
      "type": "object",
      "required": [
        "outcome",
        "dispatchState",
        "accepted",
        "finalStateReached",
        "targetMayHaveMutated",
        "readOnly",
        "foregroundUnchanged",
        "confirmationEvaluatedBeforeDispatch",
        "foregroundConsentEvaluatedBeforeDispatch",
        "retrySafe",
        "automaticRetryProhibited"
      ],
      "properties": {
        "outcome": { "const": "completed" },
        "dispatchState": { "const": "completed" },
        "accepted": { "const": true },
        "finalStateReached": { "const": true },
        "targetMayHaveMutated": { "const": false },
        "readOnly": { "const": true },
        "foregroundUnchanged": { "const": true },
        "confirmationEvaluatedBeforeDispatch": { "const": true },
        "foregroundConsentEvaluatedBeforeDispatch": { "const": true },
        "retrySafe": { "const": false },
        "automaticRetryProhibited": { "const": true }
      }
    },
    "clickData": {
      "allOf": [
        { "$ref": "#/$defs/commandCommon" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "capability",
            "action",
            "outcome",
            "dispatchState",
            "accepted",
            "finalStateReached",
            "targetMayHaveMutated",
            "clicked",
            "pageId",
            "elementId",
            "navigationGeneration",
            "foregroundUnchanged",
            "confirmationEvaluatedBeforeDispatch",
            "foregroundConsentEvaluatedBeforeDispatch",
            "retrySafe",
            "automaticRetryProhibited"
          ],
          "properties": {
            "capability": { "const": "browser.element.click@1" },
            "action": { "const": "click" },
            "outcome": { "const": "completed" },
            "dispatchState": { "const": "completed" },
            "accepted": { "const": true },
            "finalStateReached": { "const": true },
            "targetMayHaveMutated": { "const": true },
            "clicked": { "const": true },
            "pageId": { "$ref": "#/$defs/browserPageId" },
            "elementId": { "$ref": "#/$defs/browserElementId" },
            "navigationGeneration": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
            "foregroundUnchanged": { "const": true },
            "confirmationEvaluatedBeforeDispatch": { "const": true },
            "foregroundConsentEvaluatedBeforeDispatch": { "const": true },
            "retrySafe": { "const": false },
            "automaticRetryProhibited": { "const": true }
          }
        }
      ]
    },
    "typeData": {
      "allOf": [
        { "$ref": "#/$defs/commandCommon" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "capability",
            "action",
            "outcome",
            "dispatchState",
            "accepted",
            "finalStateReached",
            "targetMayHaveMutated",
            "typed",
            "utf8Bytes",
            "pageId",
            "elementId",
            "navigationGeneration",
            "foregroundUnchanged",
            "confirmationEvaluatedBeforeDispatch",
            "foregroundConsentEvaluatedBeforeDispatch",
            "retrySafe",
            "automaticRetryProhibited"
          ],
          "properties": {
            "capability": { "const": "browser.element.type@1" },
            "action": { "const": "type" },
            "outcome": { "const": "completed" },
            "dispatchState": { "const": "completed" },
            "accepted": { "const": true },
            "finalStateReached": { "const": true },
            "targetMayHaveMutated": { "const": true },
            "typed": { "const": true },
            "utf8Bytes": { "type": "integer", "minimum": 1, "maximum": 16384 },
            "pageId": { "$ref": "#/$defs/browserPageId" },
            "elementId": { "$ref": "#/$defs/browserElementId" },
            "navigationGeneration": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
            "foregroundUnchanged": { "const": true },
            "confirmationEvaluatedBeforeDispatch": { "const": true },
            "foregroundConsentEvaluatedBeforeDispatch": { "const": true },
            "retrySafe": { "const": false },
            "automaticRetryProhibited": { "const": true }
          }
        }
      ]
    },
    "screenshotData": {
      "allOf": [
        { "$ref": "#/$defs/queryCommon" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "capability",
            "action",
            "outcome",
            "dispatchState",
            "accepted",
            "finalStateReached",
            "targetMayHaveMutated",
            "readOnly",
            "pageId",
            "navigationGeneration",
            "mimeType",
            "pngBase64",
            "pngBytes",
            "width",
            "height",
            "digest",
            "foregroundUnchanged",
            "confirmationEvaluatedBeforeDispatch",
            "foregroundConsentEvaluatedBeforeDispatch",
            "retrySafe",
            "automaticRetryProhibited"
          ],
          "properties": {
            "capability": { "const": "browser.page.screenshot@1" },
            "action": { "const": "screenshot" },
            "outcome": { "const": "completed" },
            "dispatchState": { "const": "completed" },
            "accepted": { "const": true },
            "finalStateReached": { "const": true },
            "targetMayHaveMutated": { "const": false },
            "readOnly": { "const": true },
            "pageId": { "$ref": "#/$defs/browserPageId" },
            "navigationGeneration": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
            "mimeType": { "const": "image/png" },
            "pngBase64": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16777216,
              "contentEncoding": "base64"
            },
            "pngBytes": { "type": "integer", "minimum": 1, "maximum": 12582912 },
            "width": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "height": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "digest": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
            "foregroundUnchanged": { "const": true },
            "confirmationEvaluatedBeforeDispatch": { "const": true },
            "foregroundConsentEvaluatedBeforeDispatch": { "const": true },
            "retrySafe": { "const": false },
            "automaticRetryProhibited": { "const": true }
          }
        }
      ]
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["foreground", "targeting"],
      "properties": {
        "foreground": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unchanged"],
          "properties": { "unchanged": { "const": true } }
        },
        "targeting": { "const": "opaque exact browser session" }
      }
    }
  }
}
