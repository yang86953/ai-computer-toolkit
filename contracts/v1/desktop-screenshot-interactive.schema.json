{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-computer-toolkit/contracts/v1/desktop-screenshot-interactive.schema.json",
  "title": "Confirmed Wayland Portal interactive desktop screenshot result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "app",
    "operation",
    "capability",
    "targetId",
    "targetKind",
    "executionDomain",
    "confirmationRequired",
    "confirmationSatisfied",
    "foregroundConsentRequired",
    "foregroundConsentSatisfied",
    "foregroundImpact",
    "path",
    "bytes",
    "width",
    "height",
    "pixelDigest",
    "atomicOutput",
    "overwriteConfirmed",
    "replacedExisting",
    "cursorCapture",
    "oneShot",
    "coordinateMapping",
    "controllableSurfaceIdentity",
    "systemCaptureIndicatorMayAppear",
    "portal",
    "fallback"
  ],
  "properties": {
    "ok": { "const": true },
    "app": { "const": "desktop" },
    "operation": { "const": "screenshot-interactive" },
    "capability": { "const": "desktop.screenshot.interactive@1" },
    "targetId": { "type": "string", "pattern": "^s2:h:[0-9a-f]{16}$" },
    "targetKind": { "const": "host" },
    "executionDomain": { "const": "host-foreground" },
    "confirmationRequired": { "const": true },
    "confirmationSatisfied": { "const": true },
    "foregroundConsentRequired": { "const": true },
    "foregroundConsentSatisfied": { "const": true },
    "foregroundImpact": { "const": "system-portal-selection-dialog-visible" },
    "path": { "type": "string", "minLength": 5 },
    "bytes": { "type": "integer", "minimum": 1, "maximum": 67108864 },
    "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
    "height": { "type": "integer", "minimum": 1, "maximum": 16384 },
    "pixelDigest": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "atomicOutput": { "const": true },
    "overwriteConfirmed": { "type": "boolean" },
    "replacedExisting": { "type": "boolean" },
    "cursorCapture": { "const": "portal-defined" },
    "oneShot": { "const": true },
    "coordinateMapping": { "const": "none" },
    "controllableSurfaceIdentity": { "const": "none" },
    "systemCaptureIndicatorMayAppear": { "const": true },
    "portal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface", "version", "interactive", "requestState", "sourceUriExposed"],
      "properties": {
        "interface": { "const": "org.freedesktop.portal.Screenshot" },
        "version": { "type": "integer", "minimum": 2 },
        "interactive": { "const": true },
        "requestState": { "const": "completed" },
        "sourceUriExposed": { "const": false }
      }
    },
    "fallback": { "const": "none" }
  }
}
