{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://ui/key-sequence/v1",
  "title": "UIX cooperative application-internal key sequence input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["presses"],
  "properties": {
    "presses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/keyPress" }
    },
    "intervalMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 500,
      "default": 0
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 100,
      "maximum": 30000,
      "default": 30000,
      "description": "Rust validation additionally requires timeoutMs >= (presses.length - 1) * intervalMs + 100."
    }
  },
  "$defs": {
    "keyName": {
      "oneOf": [
        { "type": "string", "pattern": "^[a-z0-9]$" },
        { "type": "string", "pattern": "^f([1-9]|1[0-2])$" },
        {
          "enum": [
            "enter", "tab", "escape", "backspace", "delete", "insert", "space",
            "left", "up", "right", "down", "home", "end", "page-up", "page-down",
            "control", "alt", "shift", "super"
          ]
        }
      ]
    },
    "keyPress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "key": { "$ref": "#/$defs/keyName" },
        "modifiers": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["control", "alt", "shift", "super"] },
          "default": []
        }
      }
    }
  }
}
