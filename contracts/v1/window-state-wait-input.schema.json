{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://window/state-wait/v1",
  "title": "UIX framework-current window state wait input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["condition"],
  "properties": {
    "condition": {
      "oneOf": [
        { "$ref": "#/$defs/visibility" },
        { "$ref": "#/$defs/focus" },
        { "$ref": "#/$defs/clientSize" },
        { "$ref": "#/$defs/windowFlags" }
      ]
    },
    "pollIntervalMs": {
      "type": "integer",
      "minimum": 20,
      "maximum": 500,
      "default": 50
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 100,
      "maximum": 30000,
      "default": 30000
    }
  },
  "$defs": {
    "visibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "visibility" },
        "visible": { "type": "boolean" },
        "presentable": { "type": "boolean" }
      },
      "anyOf": [
        { "required": ["visible"] },
        { "required": ["presentable"] }
      ]
    },
    "focus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "focused"],
      "properties": {
        "type": { "const": "focus" },
        "focused": { "type": "boolean" }
      }
    },
    "clientSize": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "width", "height"],
      "properties": {
        "type": { "const": "client-size" },
        "width": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "height": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "windowFlags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "window-flags" },
        "maximized": { "type": "boolean" },
        "minimized": { "type": "boolean" },
        "fullscreen": { "type": "boolean" }
      },
      "anyOf": [
        { "required": ["maximized"] },
        { "required": ["minimized"] },
        { "required": ["fullscreen"] }
      ]
    }
  }
}
