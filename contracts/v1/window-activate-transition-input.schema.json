{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://window/activate-transition/v1",
  "title": "UIX exact window activation transition input v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "pollIntervalMs": {
      "type": "integer",
      "minimum": 20,
      "maximum": 500,
      "default": 50
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 100,
      "maximum": 30000,
      "default": 30000
    }
  }
}
