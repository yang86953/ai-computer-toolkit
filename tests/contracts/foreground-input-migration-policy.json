{
  "contractVersion": "act/foreground-input-migration-policy/v1",
  "capability": "ui.input.key@1",
  "productionRoute": "app.apply",
  "legacyOperation": "desktop.press-key",
  "rustExecutionStatus": "available-confirmed",
  "cppExecutionStatus": "retired-no-route",
  "publicRouteEnabled": true,
  "requiresConfirmation": true,
  "requiresForegroundConsent": true,
  "targetPrefix": "s2:w:",
  "keyPolicy": {
    "steps": ["key", "chord", "text"],
