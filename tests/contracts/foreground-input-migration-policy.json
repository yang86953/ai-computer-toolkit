  },
  "lifecycle": {
    "ownership": "request-scoped-balanced",
    "downUpAcrossRequestsAllowed": false,
    "releaseOrder": "reverse-press-order",
    "releaseBypassedByCancelTimeoutOrForegroundChange": false
  },
  "partialDispatch": {
    "outcome": "unknown",
    "retrySafe": false,
    "automaticRetryProhibited": true,
    "safeReleaseEvidenceRequired": true
  },
  "fixtureEvidence": {
    "projectOwnedWindow": true,
    "productionSystemRoute": true,
    "shortcutOrderVerified": true,
    "longPressVerified": true,
    "repeatVerified": true,
    "unicodeVerified": true,
    "cancelReleaseVerified": true,
    "timeoutReleaseVerified": true,
    "recoveryVerified": true
  },
  "formalGate": "owner-only-gc-va-001"
}
