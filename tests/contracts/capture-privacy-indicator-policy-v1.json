    {
      "path": "contracts/v1/capture-preflight.schema.json",
      "pointer": "/properties/privacyIndicatorMayAppearOnCapture/const"
    }
  ],
  "forbiddenSourceTokens": [
    "IsBorderRequired(false)",
    "SetIsBorderRequired(false)",
    "GraphicsCaptureAccessKind::Borderless",
    "GraphicsCaptureAccess"
  ],
  "humanVisualAcceptance": {
    "vikunjaProjectId": 2,
    "taskId": 1650,
    "assignee": "project-owner",
    "aiMayClose": false
  }
