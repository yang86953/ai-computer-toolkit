{
  "contractVersion": "act/capture-privacy-indicator-policy/v1",
  "owner": "Capture Module",
  "systemIndicatorMayAppear": true,
  "borderSuppressionAllowed": false,
  "systemBehaviorMustNotBeOverridden": true,
  "requiresHumanVisualAcceptance": true,
  "productionSourceRoots": [
    "src"
  ],
  "activeWgcSources": [
    "src/adapters/window_capture.rs"
  ],
  "schemaClaims": [
